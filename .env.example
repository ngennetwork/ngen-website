# Copy this file to ".env" (a new file, not tracked by git) and fill in
# the real value. See SETUP.md for how to get this URL from Google Apps
# Script — it's the one thing this whole backend setup produces.
#
# The newsletter form, the Start-Up Challenge application
# (POST /api/startup-challenge/apply), and the eligibility lead
# (POST /api/startup-challenge/lead) send their data to this URL.
# The challenge route also accepts APPS_SCRIPT_URL if you would rather
# keep the endpoint off the client bundle. Redeploy backend/Code.gs so it
# handles formType "startup-challenge" (sheet row, Drive resume, email
# to info@ngennetwork.org).
NEXT_PUBLIC_APPS_SCRIPT_URL=

# The one shared password for /admin/events (add/edit/delete upcoming
# events without touching code). Pick anything reasonably strong — this
# is the only thing standing between the public internet and that page.
ADMIN_PASSWORD=

# Canonical production URL — used for metadataBase, the sitemap, robots.txt,
# and JSON-LD structured data. Defaults to https://ngennetwork.org if unset.
NEXT_PUBLIC_SITE_URL=https://ngennetwork.org
